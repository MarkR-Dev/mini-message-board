<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <main>
      <h1>Messages</h1>

      <a href="/new" class="link">New Message</a>

      <div class="messages-container">
        <% messages.forEach((message) => { %>
        <div class="message">
          <div class="first-line">
            <h2 class="user"><%= message.username %></h2>
            <a href="/messages/<%= message.id %>" class="open">Open</a>
          </div>
          <h3 class="text"><%= message.message %></h3>
          <h3 class="added"><%= message.date_posted %></h3>
        </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
